# Node.js di Termux -> CubicCraft di Minecraft Hosting
# Untuk mode outbound, isi IP/hostname server Minecraft dan port Node Bridge.
# MINECRAFT_PORT harus sama dengan node-bridge.port pada config.yml CubicCraft.
# Nilai contoh di bawah sesuai default source; ubah jika panel memakai alamat/port lain.
MINECRAFT_OUTBOUND_ENABLED=true
MINECRAFT_HOST=51.81.107.169
MINECRAFT_PORT=25942
MINECRAFT_RECONNECT_DELAY=5000

# Tidak perlu username TikTok di sini. Username diberikan dari /cc host.
TIKTOK_API_KEY=

# Port WebSocket untuk mode langsung; aktifkan dengan MINECRAFT_OUTBOUND_ENABLED=false
WS_PORT=25601
